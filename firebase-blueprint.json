{
  "entities": {
    "DispatchLog": {
      "title": "DispatchLog",
      "description": "Daily dispatch log record for manpower placement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "clientName": { "type": "string" },
        "clientContact": { "type": "string" },
        "generalGongsuCount": { "type": "number" },
        "skillGongsuCount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "memo": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date", "clientName"]
    },
    "WorkerMaster": {
      "title": "WorkerMaster",
      "description": "Worker master roster entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "defaultDailyRate": { "type": "number" },
        "phone": { "type": "string" }
      },
      "required": ["id", "name", "category", "defaultDailyRate"]
    },
    "ClientSiteMaster": {
      "title": "ClientSiteMaster",
      "description": "Client or construction site entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "clientName"]
    },
    "OfficeSettings": {
      "title": "OfficeSettings",
      "description": "Office contact and bank details settings",
      "type": "object",
      "properties": {
        "officeName": { "type": "string" },
        "phone1": { "type": "string" },
        "phone2": { "type": "string" },
        "address": { "type": "string" },
        "bankAccount": { "type": "string" }
      },
      "required": ["officeName"]
    },
    "OfficeProfile": {
      "title": "OfficeProfile",
      "description": "Office profiles for dispatch printing and delegation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profileName": { "type": "string" },
        "officeName": { "type": "string" },
        "registrationNumber": { "type": "string" },
        "bizType": { "type": "string" },
        "bizCategory": { "type": "string" },
        "email": { "type": "string" },
        "phone1": { "type": "string" },
        "phone2": { "type": "string" },
        "address": { "type": "string" },
        "bankAccount": { "type": "string" },
        "representativeName": { "type": "string" },
        "representativeResidentId": { "type": "string" },
        "representativeAccount": { "type": "string" },
        "adminEmails": { "type": "array", "items": { "type": "string" } },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "officeName"]
    },
    "TaxInvoice": {
      "title": "TaxInvoice",
      "description": "Electronic tax invoice records and management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "issueDate": { "type": "string" },
        "ntsIssueId": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierRegistrationNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "clientRegistrationNumber": { "type": "string" },
        "taxType": { "type": "string" },
        "supplyAmount": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" }
      },
      "required": ["id", "issueDate", "clientName", "totalAmount"]
    }
  },
  "firestore": {
    "/dispatch_logs/{logId}": {
      "schema": { "$ref": "#/entities/DispatchLog" },
      "description": "Collection of dispatch logs"
    },
    "/workers/{workerId}": {
      "schema": { "$ref": "#/entities/WorkerMaster" },
      "description": "Collection of worker roster items"
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/ClientSiteMaster" },
      "description": "Collection of client site items"
    },
    "/tax_invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/TaxInvoice" },
      "description": "Collection of tax invoices"
    },
    "/office_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/OfficeProfile" },
      "description": "Collection of office profiles"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/OfficeSettings" },
      "description": "Settings collection"
    },
    "/_connection_test/{testId}": {
      "schema": { "$ref": "#/entities/OfficeSettings" },
      "description": "Connection test collection"
    }
  }
}
